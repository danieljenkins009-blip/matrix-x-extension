{
  "manifest_version": 3,
  "name": "Matrix X",
  "version": "0.1.0",
  "description": "Transform X.com into the Matrix. Live tweets stream as glowing green code across a digital void. Jack into the simulation.",
  "icons": {
    "16": "icons/icon16.png"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}